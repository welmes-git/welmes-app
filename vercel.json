{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/client",
  "functions": {
    "api/ssr.ts": {
      "includeFiles": "dist/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/products/:id/:slug", "destination": "/api/ssr?path=/products/:id/:slug" },
    { "source": "/products/:id", "destination": "/api/ssr?path=/products/:id" },
    { "source": "/product/:id", "destination": "/api/ssr?path=/product/:id" },
    { "source": "/sitemap.xml", "destination": "/api/ssr?path=/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api/ssr?path=/robots.txt" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
